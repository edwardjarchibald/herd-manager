#!/usr/bin/env python3
"""herd: one plain Terminal.app window per herdr terminal.
Name = herdr workspace label (stored in herdr itself; no side file).
  herd new [DIR|NAME] [-C DIR]  create workspace+terminal with cwd DIR (default ~) and an automatic name
                    (ee-<issue> / dev-N); a non-path argument is a manual NAME. Prints name + ids
  herd ls           list name, terminal id, pane id, cwd, foreground command
  herd open <name>  open a Terminal.app window titled <name> running `herdr terminal attach <id>`
  herd kill <name>  close the herdr workspace
  herd id <name>    print pane id (for herdr pane read/run)
  herd tile         retile herd-created Terminal windows (even grid) on the newest one's display
  herd untile       placeholder (no-op)
  herd attach <name> (used inside herd windows) attach + clean up/retile on exit
  herd killall [GLOB...]  kill ALL herdr sessions (herd + external), or only names matching any glob; --all = no args
  herd detach <name> close the session's herd window, keep the session running
  herd broadcast '<text>'  run text+Enter in every session with an open herd window
  herd cleanclip    strip trailing padding spaces from the clipboard (after Cmd-C in an attach window)
  herd copy <name>  copy the session's full output to the clipboard (pbcopy)
  herd paste <name> paste the clipboard into the session as text, no Enter
  herd manager      curses session manager (run inside its own Terminal window)
  herd manager --window   open/focus the manager window (left column of the tiling area)
Only Terminal windows recorded in ~/.config/herd/windows.json are ever moved.

Test hooks (environment variables, for headless testing of `herd manager`; unset in normal use):
  HERD_TEST_SANDBOX=<log>   fake session rows; every mutating action is only logged to <log>
  HERD_TEST_ROWS=<n>        number of fake rows in sandbox mode (default 6)
  HERD_TEST_STATE=<file>    write selection/focus/help state after each frame
  HERD_TEST_DUMP=<file>     write a plain-text dump of the screen after each frame
  HERD_TEST_KEYLOG=<file>   append the last key code after each frame
  HERD_TEST_STUB_OPEN=<f>   log O opens instead of opening windows
  HERD_NO_OUTLINE=1         don't start the green window-outline helper
"""
import json, os, re, shlex, subprocess, sys, time, fcntl
os.environ["PATH"] = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:" + os.environ.get("PATH", "")
NAME_RE = re.compile(r"^[^\x00-\x1f\x7f\"'`$\\]{1,120}$")   # labels may contain / ~ spaces ( )

_server_checked = []

def server_running():
    p = subprocess.run(["herdr", "status", "server"], capture_output=True, text=True)
    return "status: running" in p.stdout

def ensure_server(timeout=8.0):
    """Start a background `herdr server` if none is running (e.g. right after login).
    Never starts a duplicate: checks `herdr status` and for an existing `herdr server` process."""
    if _server_checked: return
    _server_checked.append(1)
    if server_running(): return
    if subprocess.run(["pgrep", "-f", "herdr server$"], capture_output=True).returncode == 0:
        pass  # a server process exists but isn't answering yet; just wait for it
    else:
        logdir = os.path.expanduser("~/.config/herdr"); os.makedirs(logdir, exist_ok=True)
        with open(os.path.join(logdir, "server-herd.log"), "ab") as log:
            subprocess.Popen(["herdr", "server"], cwd=os.path.expanduser("~"), stdin=subprocess.DEVNULL,
                             stdout=log, stderr=log, start_new_session=True)
    end = time.time() + timeout
    while time.time() < end:
        if server_running(): return
        time.sleep(0.2)
    sys.exit("herd: herdr server did not start (see ~/.config/herdr/server-herd.log)")

def h(*a):
    ensure_server()
    p = subprocess.run(["herdr", *a], capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit(f"herdr {' '.join(a)} failed: {p.stderr.strip() or p.stdout.strip()}")
    return json.loads(p.stdout)["result"] if p.stdout.strip() else {}

def workspaces(): return h("workspace", "list")["workspaces"]
def panes(): return h("pane", "list")["panes"]

def find(name):
    """Exact session name, else a unique prefix of one."""
    ws = workspaces()
    hit = [w for w in ws if w["label"] == name] or [w for w in ws if w["label"].startswith(name)]
    if len(hit) > 1: sys.exit(f"{name!r} is ambiguous: " + ", ".join(w["label"] for w in hit))
    if not hit: sys.exit(f"no herd session named {name!r} (see `herd ls`)")
    w = hit[0]
    ps = [p for p in panes() if p["workspace_id"] == w["workspace_id"]]
    if not ps: sys.exit(f"{w['label']}: workspace has no panes")
    return w, ps[0]

# ---- program label (never argv: command lines can contain secrets) ----
def prog_label(p, fp=None):
    if p.get("agent"): return p["agent"]
    if fp is None:
        try: fp = h("pane", "process-info", "--pane", p["pane_id"])["process_info"]["foreground_processes"]
        except SystemExit: fp = []
    if not fp: return ""
    nm = fp[0].get("name") or ""
    return os.path.basename(nm).lstrip("-")

# ---- automatic session names: <repo>/<branch> in git, else the cwd with ~ ----
NAMES_META = os.path.expanduser("~/.config/herd/names.json")
_git_cache = {}

PREFIXES = os.path.expanduser("~/.config/herd/prefixes.json")

def git_info(cwd):
    """{'repo','branch','linked','toplevel','origin'} for a cwd inside git, else None (cached ~3s)."""
    hit = _git_cache.get(cwd)
    if hit and time.time() - hit[0] < 3: return hit[1]
    res = None
    try:
        r = subprocess.run(["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir",
                            "--git-dir", "--show-toplevel", "--abbrev-ref", "HEAD"],
                           capture_output=True, text=True, timeout=3)
        if r.returncode == 0:
            common, gdir, top, branch = (r.stdout.split("\n") + [""] * 4)[:4]
            common = common.rstrip("/")
            repo = os.path.basename(os.path.dirname(common)) if os.path.basename(common) == ".git" \
                else os.path.basename(common).removesuffix(".git")
            if branch in ("HEAD", ""):
                b = subprocess.run(["git", "-C", cwd, "rev-parse", "--short", "HEAD"], capture_output=True, text=True, timeout=3)
                branch = b.stdout.strip() or "HEAD"
            o = subprocess.run(["git", "-C", cwd, "config", "--get", "remote.origin.url"], capture_output=True, text=True, timeout=3)
            origin = re.sub(r"\.git$", "", o.stdout.strip().rstrip("/")).split("/")[-1].split(":")[-1] if o.stdout.strip() else ""
            res = {"repo": repo, "branch": branch, "linked": gdir.rstrip("/") != common, "toplevel": top, "origin": origin}
    except (OSError, subprocess.SubprocessError): pass
    _git_cache[cwd] = (time.time(), res)
    return res

def git_name(cwd):
    """Detail line: '<main repo folder>/<branch>' (short hash if detached), or None outside git."""
    g = git_info(cwd)
    return f"{g['repo']}/{g['branch']}" if g else None

ISSUE_BRANCH = [r"(?:^|[/_-])issues?[-_/#]?(\d+)", r"(?:^|[/_-])gh[-_]?(\d+)", r"#(\d+)",
                r"^(\d+)(?:[-_]|$)", r"/(\d+)(?:[-_]|$)"]

def issue_number(branch, folder):
    for pat in ISSUE_BRANCH:
        m = re.search(pat, branch or "", re.I)
        if m: return m.group(1)
    m = re.search(r"issues?[-_]?(\d+)", folder or "", re.I) or re.search(r"[-_](\d+)$", folder or "")
    return m.group(1) if m else None

def abbrev(name):
    """Best 2-4 letter abbreviation: BlackHole->bh, herd-manager->hm, react-native->rn, herdr->her."""
    name = re.sub(r"[-_. ]?[vV]\d+$", "", name) or name           # drop version suffix (repo_V1)
    parts = [p for p in re.split(r"[-_. ]+", name) if p]
    words = []
    for p in parts:
        words += re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", p) or [p]
    words = [w for w in words if not re.fullmatch(r"[vV]?\d+", w)] or words
    if len(words) >= 2: return "".join(w[0] for w in words[:4]).lower()
    return (words[0][:3] if words else "x").lower()

def repo_prefix(g):
    name = g["origin"] or g["repo"]
    try: over = json.load(open(PREFIXES))
    except Exception:
        over = {"elephant_ears_V1": "ee"}
        try:
            os.makedirs(os.path.dirname(PREFIXES), exist_ok=True); json.dump(over, open(PREFIXES, "w"), indent=1)
        except OSError: pass
    for k in (name, g["repo"]):
        for ok, ov in over.items():
            if ok.lower() == k.lower(): return ov
    if re.search(r"elephant[-_]ears", name + g["repo"], re.I): return "ee"
    return abbrev(name)

def tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path == home or path.startswith(home + "/") else path

def desired_name(cwd):
    """Session name: '<prefix>-<issue>' in a linked worktree with an issue number, else dev-<N>."""
    if not cwd: return DEV
    try: cwd = os.path.realpath(cwd)                 # ~/git -> ~/Development/git etc.
    except OSError: pass
    g = git_info(cwd)
    if g and g["linked"]:
        n = issue_number(g["branch"], os.path.basename(g["toplevel"]))
        if n: return f"{repo_prefix(g)}-{n}"
    # Fallback by path: .../worktrees/<repo>/<anything>issue-<N>[/...] even when git doesn't see a worktree
    # there (e.g. a removed/unregistered worktree folder, or a non-git subfolder of one).
    m = re.search(r"/worktrees/([^/]+)/[^/]*?issues?[-_]?(\d+)(?:/|$)", cwd, re.I)
    if m and not g:
        return f"{repo_prefix({'origin': '', 'repo': m.group(1)})}-{m.group(2)}"
    return DEV                                          # everything else: a stable dev-<N>

DEV = "\0dev"   # sentinel: assign a stable dev-<N>

def detail_cwd(cwd):
    """Detail line / CWD column: '<repo>/<branch>' inside git, else the cwd with ~."""
    return git_name(cwd) or tilde(cwd) if cwd else ""

def lowest_dev(taken):
    n = 1
    while f"dev-{n}" in taken: n += 1
    return f"dev-{n}"

def uniquify(base, taken):
    if base not in taken: return base
    n = 2
    while f"{base}-{n}" in taken: n += 1
    return f"{base}-{n}"

def _meta(fn=None):
    os.makedirs(os.path.dirname(NAMES_META), exist_ok=True)
    with open(NAMES_META + ".lock", "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try: d = json.load(open(NAMES_META))
        except Exception: d = {}
        r = fn(d) if fn else None
        if fn:
            tmp = NAMES_META + ".tmp"; json.dump(d, open(tmp, "w"), indent=1); os.replace(tmp, NAMES_META)
        return d if fn is None else r

def is_manual(meta, w):
    m = meta.get(w["workspace_id"])
    return bool(m and m.get("manual") and m.get("label") == w["label"])

def _relabel(w, new_):
    """Rename a herdr workspace and carry its herd window record/title along."""
    old = w["label"]
    h("workspace", "rename", w["workspace_id"], new_)
    def mv(d):
        if old in d and new_ not in d: d[new_] = d.pop(old)
        return d.get(new_)
    r = _locked(mv)
    if r: subprocess.run(["osascript", "-e", f'tell application "Terminal" to set custom title of selected tab of window id {int(r["wid"])} to {osa_str(new_)}'], capture_output=True)

def auto_names(apply=True, ws=None, ps=None):
    """Recompute automatic names for every session (manual ones keep theirs). Returns [(old, new)]."""
    ws = workspaces() if ws is None else ws
    ps = panes() if ps is None else ps
    meta = _meta()
    cwd_of = {p["workspace_id"]: (p.get("foreground_cwd") or p.get("cwd") or "") for p in ps}
    ws = sorted(ws, key=lambda w: w.get("number", 0))
    taken = {w["label"] for w in ws if is_manual(meta, w)}
    keep_dev = {w["label"] for w in ws if not is_manual(meta, w) and re.fullmatch(r"dev-\d+", w["label"])
                and desired_name(cwd_of.get(w["workspace_id"], "")) == DEV}   # existing dev-N stay put
    changes = []
    for w in ws:
        if is_manual(meta, w): continue
        base = desired_name(cwd_of.get(w["workspace_id"], ""))
        if base == DEV:   # keep an existing dev-N; otherwise take the lowest free number
            if re.fullmatch(r"dev-\d+", w["label"]) and w["label"] not in taken: want = w["label"]
            else: want = lowest_dev(taken | keep_dev)
            taken.add(want)
            if want != w["label"]: changes.append((w, want))
            continue
        want = base if w["label"] == base and base not in taken else None
        if want is None:
            m = re.fullmatch(re.escape(base) + r"-(\d+)", w["label"])
            want = w["label"] if m and w["label"] not in taken else uniquify(base, taken)
        taken.add(want)
        if want != w["label"]: changes.append((w, want))
    if apply:
        for w, new_ in changes: _relabel(w, new_)
    return [(w["label"], n) for w, n in changes]

def new(name=None, cwd=None):
    labels = {w["label"] for w in workspaces()}
    manual = name is not None
    if name is None:
        name = lowest_dev(labels)
    elif not NAME_RE.match(name): sys.exit("name must not contain quotes, $, backslash or control characters")
    elif name in labels: sys.exit(f"{name!r} already exists")
    r = h("workspace", "create", "--label", name, "--cwd", cwd or os.path.expanduser("~"), "--no-focus")
    p = r["root_pane"]
    if manual:
        wid_ = r["workspace"]["workspace_id"]
        _meta(lambda d: d.__setitem__(wid_, {"manual": True, "label": name}))
    elif cwd:
        try:
            auto_names()                                   # dev-N -> ee-<issue> etc. right away
            name = next((w["label"] for w in workspaces() if w["workspace_id"] == r["workspace"]["workspace_id"]), name)
        except SystemExit: pass
    print(f"{name}\t{p['terminal_id']}\t{p['pane_id']}")
    return name

def ls():
    ws = {w["workspace_id"]: w["label"] for w in workspaces()}
    print(f"{'NAME':24} {'TERMINAL_ID':20} {'PANE':7} {'CWD':45} COMMAND")
    for p in panes():
        if p["workspace_id"] not in ws: continue
        cmd = prog_label(p)
        cwd = detail_cwd(p.get("foreground_cwd") or p.get("cwd", ""))
        print(f"{ws[p['workspace_id']]:24} {p.get('terminal_id',''):20} {p['pane_id']:7} {cwd:45} {cmd}")

def osa_str(s): return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'

GAP = 8
WINFILE = os.path.expanduser("~/.config/herd/windows.json")

def _sess_map():
    """(label -> terminal id, terminal id -> label, workspace id -> terminal id) for live sessions."""
    try:
        ws = {w["workspace_id"]: w["label"] for w in workspaces()}
        l2t, t2l, w2t = {}, {}, {}
        for p in panes():
            if p["workspace_id"] in ws and p.get("terminal_id"):
                l2t[ws[p["workspace_id"]]] = p["terminal_id"]; t2l[p["terminal_id"]] = ws[p["workspace_id"]]
                w2t[p["workspace_id"]] = p["terminal_id"]
        return l2t, t2l, w2t
    except SystemExit:
        return {}, {}, {}

def _locked(fn):
    """windows.json is stored keyed by herdr TERMINAL ID (stable across renames). fn gets a view keyed
    by the current session name (records of vanished sessions appear as '#<terminal id>'), so names
    can change freely without breaking records. Old name-keyed files are migrated on the fly."""
    os.makedirs(os.path.dirname(WINFILE), exist_ok=True)
    with open(WINFILE + ".lock", "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try: disk = json.load(open(WINFILE))
        except Exception: disk = {}
        l2t, t2l, w2t = _sess_map()
        view = {}
        for k, r in disk.items():
            if k == MGR: view[k] = r; continue
            tid = r.get("tid") or (k if k.startswith("term_") else None) or w2t.get(r.get("ws")) or l2t.get(k)
            if not tid: continue                                   # unresolvable legacy record: drop
            r = dict(r, tid=tid)
            view[t2l.get(tid, "#" + tid)] = r
        res = fn(view)
        out = {}
        for k, r in view.items():
            if k == MGR: out[k] = r; continue
            tid = r.get("tid") or (k[1:] if k.startswith("#") else l2t.get(k))
            if tid: out[tid] = dict(r, tid=tid, name=t2l.get(tid, r.get("name", k)))
        tmp = WINFILE + ".tmp"; json.dump(out, open(tmp, "w"), indent=1); os.replace(tmp, WINFILE)
        return res

def grid(x, y, w, h, n, gap=GAP):
    """Even grid: 1-3 -> n columns; 4 -> 2x2; 5-9 -> 3 columns; >9 -> ceil(sqrt(n)) columns.
    Rows = ceil(n/cols); a partial last row widens to fill. Returns [(l, t, r, b)] top-left coords."""
    import math
    if n <= 0: return []
    cols = n if n <= 3 else 2 if n == 4 else 3 if n <= 9 else math.ceil(math.sqrt(n))
    rows = math.ceil(n / cols)
    x, y, w, h = x + gap, y + gap, w - 2 * gap, h - 2 * gap
    rh = (h - gap * (rows - 1)) / rows
    out = []
    for r in range(rows):
        k = min(cols, n - r * cols)
        cw = (w - gap * (k - 1)) / k
        top = y + r * (rh + gap)
        for c in range(k):
            left = x + c * (cw + gap)
            out.append((round(left), round(top), round(left + cw), round(top + rh)))
    return out

JXA_QUERY = r"""
ObjC.import('AppKit');
function run(argv){
  var ids = JSON.parse(argv[0]), T = Application('Terminal'), res = {screens: [], windows: {}};
  var s = $.NSScreen.screens, mainH = s.objectAtIndex(0).frame.size.height;
  for (var i = 0; i < s.count; i++) { var v = s.objectAtIndex(i).visibleFrame;
    // NSScreen: bottom-left origin, y up. Terminal bounds: top-left of main screen, y down.
    res.screens.push([v.origin.x, mainH - (v.origin.y + v.size.height), v.size.width, v.size.height]); }
  if (T.running()) ids.forEach(function(id){ try { var b = T.windows.byId(id).bounds();
      res.windows[id] = [b.x, b.y, b.x + b.width, b.y + b.height]; } catch(e) {} });
  return JSON.stringify(res);
}"""
JXA_SET = r"""
function run(argv){
  var T = Application('Terminal'), m = JSON.parse(argv[0]);
  for (var id in m) { try { var r = m[id];
      T.windows.byId(parseInt(id)).bounds = {x: r[0], y: r[1], width: r[2]-r[0], height: r[3]-r[1]}; } catch(e) {} }
  return "ok";
}"""

def _jxa(src, arg):
    p = subprocess.run(["osascript", "-l", "JavaScript", "-e", src, json.dumps(arg)], capture_output=True, text=True)
    if p.returncode: sys.exit("osascript: " + p.stderr.strip())
    return p.stdout.strip()

SEL_256 = 25            # selection colour: xterm-256 #25 = #005faf (slate blue); outline uses the same RGB
SEL_RGB = "0 95 175"
MGR = "__manager__"   # windows.json key for the manager window (role: manager)
MGR_W = 520

def layout(x, y, w, h, n, manager=False, gap=GAP):
    """Manager column (fixed MGR_W, full height, top-left) + even grid in the rest."""
    if not manager: return None, grid(x, y, w, h, n, gap)
    m = (x + gap, y + gap, x + gap + MGR_W, y + h - gap)
    return m, grid(x + gap + MGR_W, y, w - gap - MGR_W, h, n, gap)

CFGFILE = os.path.expanduser("~/.config/herd/config.json")
DOCK_AREA = os.path.expanduser("~/.config/herd/dock-area.json")
DOCK_STATE = os.path.expanduser("~/.config/herd/dock.json")

DOCK_MIN_W = 920   # default minimum dock/left-panel width (Grok Bot's window measured 916 px)

def config():
    """~/.config/herd/config.json, e.g. {"dock": false}. Missing file/keys = defaults (dock on)."""
    try: c = json.load(open(CFGFILE))
    except Exception: c = {}
    try: mw = int(c.get("dock_min_width", DOCK_MIN_W))
    except (TypeError, ValueError): mw = DOCK_MIN_W
    return {"dock": c.get("dock", True) is not False, "dock_min_width": mw}

def docked():
    """{"pid","bundle","wid"} of the window docked by herd-dock, or None."""
    try: d = json.load(open(DOCK_STATE))
    except Exception: return None
    return d if d.get("pid") else None

def span_grid(x, y, w, h, n, gap=GAP):
    """Dock-mode terminal tiling. Rows as cell counts: 1 = [1]; 2 = [2]; 3 = [2, 1]; 4 = [2, 2];
    5 = [2, 2, 1]; 6 = 3 rows x 2 cols. 7+: 3 rows, ceil(n/3) columns, filled column by column; the
    last, partly filled column's cells share its full height (e.g. 7 -> one full-height cell)."""
    import math
    if n <= 0: return []
    x, y, w, h = x + gap, y + gap, w - 2 * gap, h - 2 * gap
    out = []
    if n <= 5:
        rows = {1: [1], 2: [2], 3: [2, 1], 4: [2, 2], 5: [2, 2, 1]}[n]
        rh = (h - gap * (len(rows) - 1)) / len(rows)
        for r, k in enumerate(rows):
            t = y + r * (rh + gap); cw = (w - gap * (k - 1)) / k
            for c in range(k):
                l = x + c * (cw + gap)
                out.append((round(l), round(t), round(l + cw), round(t + rh)))
        return out
    cols = max(2, math.ceil(n / 3))
    cw = (w - gap * (cols - 1)) / cols
    for c in range(cols):
        k = min(3, n - 3 * c)
        if k <= 0: break
        rh = (h - gap * (k - 1)) / k; l = x + c * (cw + gap)
        for r in range(k):
            t = y + r * (rh + gap)
            out.append((round(l), round(t), round(l + cw), round(t + rh)))
    return out

def dock_layout(x, y, w, h, n, gap=GAP):
    """Dock on: left panel = max(30% of the tiled width, dock_min_width). Manager on top, exactly one row of a 3-row grid
    (so its bottom lines up with terminal row 1 at 7-9 terminals); dock = rest of the panel below.
    Terminals: span_grid() in the area to the right. Returns (manager, terminal rects, dock, terminal area)."""
    lw = max(round(w * 0.3), config()["dock_min_width"])
    rh = (h - 4 * gap) / 3
    m = (x + gap, y + gap, x + gap + lw, round(y + gap + rh))
    d = (x + gap, round(y + 2 * gap + rh), x + gap + lw, y + h - gap)
    area = (x + gap + lw, y, w - gap - lw, h)
    return m, span_grid(*area, n, gap), d, area

def fit_manager_font(wid, maxfs=16, minfs=9):
    """Largest Monaco size <= maxfs at which the manager shows every session on one line plus the
    divider and broadcast line (n + 2 rows). Only the manager window's own tab is changed."""
    try: need = max(1, len(workspaces())) + 2
    except SystemExit: return
    wid = int(wid)
    def get(): 
        r = subprocess.run(["osascript", "-e", f'tell application "Terminal" to get {{font size, number of rows}} of selected tab of window id {wid}'],
                           capture_output=True, text=True).stdout.replace(" ", "").split(",")
        return (int(float(r[0])), int(r[1])) if len(r) == 2 else (0, 0)
    b = subprocess.run(["osascript", "-e", f'tell application "Terminal" to get bounds of window id {wid}'], capture_output=True, text=True).stdout.strip()
    fs, rows = get()
    if not fs: return
    for size in range(maxfs, minfs - 1, -1):
        if size != fs:
            subprocess.run(["osascript", "-e", f'tell application "Terminal"\n set font size of selected tab of window id {wid} to {size}\n set bounds of window id {wid} to {{{b}}}\nend tell'], capture_output=True)
            fs, rows = get()
        if rows >= need: break

def tile(quiet=False):
    recs = _locked(lambda d: dict(d))
    if not recs: return
    q = json.loads(_jxa(JXA_QUERY, [r["wid"] for r in recs.values()]))
    alive = {n: r for n, r in recs.items() if str(r["wid"]) in q["windows"]}
    dead = set(recs) - set(alive)
    if dead: _locked(lambda d: [d.pop(n, None) for n in dead])
    if not alive: return
    def screen_of(b):
        cx, cy = (b[0] + b[2]) / 2, (b[1] + b[3]) / 2
        for sc in q["screens"]:
            if sc[0] <= cx < sc[0] + sc[2] and sc[1] <= cy < sc[1] + sc[3]: return sc
        return None
    win = lambda n: q["windows"][str(alive[n]["wid"])]
    order = sorted((n for n in alive if n != MGR), key=lambda n: alive[n]["created"])
    newest = order[-1] if order else MGR
    target = screen_of(win(newest)) or q["screens"][0]
    zoomed = next((n for n in order if alive[n].get("zoom")), None)
    same = [n for n in order if n != zoomed and screen_of(win(n)) == target]
    has_mgr = MGR in alive and (not order or screen_of(win(MGR)) in (target, None))
    mrect, rects = layout(*target, len(same), manager=has_mgr)
    gx, gy, gw, gh = target
    if has_mgr: gx, gw = gx + GAP + MGR_W, gw - GAP - MGR_W
    dock_rect, term_area = None, (gx, gy, gw, gh)
    if config()["dock"]:
        m2, rects, dock_rect, term_area = dock_layout(*target, len(same))
        if has_mgr: mrect = m2
        tmp = DOCK_AREA + ".tmp"; json.dump({"area": list(dock_rect)}, open(tmp, "w")); os.replace(tmp, DOCK_AREA)
    elif os.path.exists(DOCK_AREA): os.remove(DOCK_AREA)
    moves = {str(alive[n]["wid"]): r for n, r in zip(same, rects)}
    if has_mgr: moves[str(alive[MGR]["wid"])] = mrect
    if zoomed:   # ~80% of the terminal area (right of the manager/dock column), centered
        x, y, w, h = term_area
        zw, zh = round(w * 0.8), round(h * 0.8)
        l, t = round(x + (w - zw) / 2), round(y + (h - zh) / 2)
        moves[str(alive[zoomed]["wid"])] = (l, t, l + zw, t + zh)
    changed = sum(1 for wid, r in moves.items() if [round(v) for v in q["windows"][wid]] != list(r))
    _jxa(JXA_SET, moves)
    if has_mgr and dock_rect: fit_manager_font(alive[MGR]["wid"])
    if zoomed: raise_behind_manager(alive[zoomed]["wid"])      # zoomed stays on top of Terminal's stack
    if dock_rect: dock_raise()
    if not quiet:
        print(f"tile: {len(alive)} herd window(s) tracked, {len(same)} on target display"
              f"{' + manager' if has_mgr else ''}, {changed} moved, {len(dead)} pruned")

def _open_window(shell_cmd, title, activate=True):
    """Open one new Terminal window running shell_cmd; return its window id.
    Robust after login: if Terminal isn't running, launch it and wait; reuse a default window it
    created, otherwise let `do script` create one. The id lookup is retried; activate comes last."""
    script = f'''
tell application "Terminal"
  set wasRunning to running
  if not wasRunning then
    launch
    repeat 50 times
      if running then exit repeat
      delay 0.1
    end repeat
    delay 0.5
  end if
  if (not wasRunning) and ((count of windows) > 0) then
    set t to do script {osa_str(shell_cmd)} in window 1
  else
    set t to do script {osa_str(shell_cmd)}
  end if
  set wid to missing value
  repeat 30 times
    try
      set wid to id of (first window whose selected tab is t)
      exit repeat
    end try
    delay 0.1
  end repeat
  if wid is missing value then set wid to id of front window
  try
    set custom title of t to {osa_str(title)}
    set title displays custom title of t to true
    set title displays shell path of t to false
    set title displays window size of t to false
    set title displays device name of t to false
  end try
  return wid
end tell'''
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip().isdigit():
        raise RuntimeError(f"Terminal AppleScript failed: {(r.stderr or r.stdout).strip()}"
                           + (" (allow it in System Settings > Privacy & Security > Automation > Terminal)"
                              if "-1743" in r.stderr else ""))
    wid = int(r.stdout.strip())
    if activate: subprocess.run(["osascript", "-e", 'tell application "Terminal" to activate'], capture_output=True)
    return wid

def _win_alive(wid):
    p = subprocess.run(["osascript", "-e", f'tell application "Terminal" to if it is running then return exists window id {int(wid)}'],
                       capture_output=True, text=True)
    return p.stdout.strip() == "true"

def focus_window(wid):
    """Bring ONE recorded herd window to the front."""
    subprocess.run(["osascript", "-e", f'''tell application "Terminal"
  set index of window id {int(wid)} to 1
  activate
end tell'''], capture_output=True)

import contextlib
@contextlib.contextmanager
def keep_front():
    """Safety net: whatever runs inside must not change the frontmost app. If it did, hand the
    front back to the app that was frontmost before (NSRunningApplication; no Accessibility)."""
    before = frontmost_pid()
    try: yield
    finally:
        if before and frontmost_pid() != before:
            subprocess.run(["osascript", "-l", "JavaScript", "-e", JXA_REFRONT, before], capture_output=True)

def refocus_manager():
    """Put the manager window back on top of Terminal's own stack WITHOUT activating Terminal.
    (It used to call focus_window = `activate`, which pulled Terminal over the frontmost app.)"""
    r = _locked(lambda d: d.get(MGR))
    if not r: return
    with keep_front():
        subprocess.run(["osascript", "-e", f'tell application "Terminal" to if it is running then set index of window id {int(r["wid"])} to 1'],
                       capture_output=True)

def close_window(wid):
    subprocess.run(["osascript", "-e", f'tell application "Terminal" to close window id {int(wid)} saving no'], capture_output=True)

def recorded(name):
    r = _locked(lambda d: d.get(name))
    return r if r and _win_alive(r["wid"]) else None

def manager_window(tile_after=True):
    r = recorded(MGR)
    if r: focus_window(r["wid"]); return
    wid = _open_window(f"clear; exec {os.path.abspath(sys.argv[0])} manager", "herd manager")
    _locked(lambda d: d.__setitem__(MGR, {"wid": wid, "created": time.time(), "role": "manager"}))
    if tile_after: tile(quiet=True)

JXA_FRONT = "ObjC.import('AppKit'); var a = $.NSWorkspace.sharedWorkspace.frontmostApplication; a.isNil() ? '' : a.processIdentifier"
JXA_REFRONT = """ObjC.import('AppKit');
function run(argv){ var a = $.NSRunningApplication.runningApplicationWithProcessIdentifier(parseInt(argv[0]));
  if (!a.isNil()) a.activateWithOptions($.NSApplicationActivateIgnoringOtherApps); return 'ok'; }"""

def orphan_window(label):
    """Id of a Terminal window whose custom title is exactly `label` and that no record claims."""
    claimed = {r["wid"] for r in _locked(lambda d: dict(d)).values()}
    r = subprocess.run(["osascript", "-l", "JavaScript", "-e",
        "var T=Application('Terminal'); T.running() ? JSON.stringify(T.windows().map(function(w){try{return [w.id(), w.selectedTab().customTitle()]}catch(e){return [0,'']}})) : '[]'"],
        capture_output=True, text=True)
    try:
        for wid, title in json.loads(r.stdout or "[]"):
            if title == label and wid and wid not in claimed: return wid
    except ValueError: pass
    return None

def frontmost_pid():
    r = subprocess.run(["osascript", "-l", "JavaScript", "-e", JXA_FRONT], capture_output=True, text=True)
    return r.stdout.strip()

def open_(name, quiet=False, keep_manager_focus=False, background=False):
    """Open (or raise) the session's window. background=True (manager Enter/N): never activate
    Terminal; raise only within Terminal's stack behind the manager, and if macOS activated Terminal
    anyway, hand the front back to the app that was frontmost before (NSRunningApplication; no
    Accessibility needed)."""
    find(name)
    r = recorded(name)
    if r:
        if background: raise_behind_manager(r["wid"])
        else: focus_window(r["wid"])
        return
    w_, p_ = find(name); name = w_["label"]
    orphan = orphan_window(name)
    if orphan:   # a herd window for this session exists but its record was lost: adopt it
        _locked(lambda d: d.__setitem__(name, {"wid": orphan, "created": time.time(), "role": "session",
                                                "ws": w_["workspace_id"], "tid": p_["terminal_id"]}))
        tile(quiet=quiet)
        if background: raise_behind_manager(orphan)
        else: focus_window(orphan)
        return
    before = frontmost_pid() if background else ""
    wid = _open_window(f"clear; exec {shlex.quote(os.path.abspath(sys.argv[0]))} attach {shlex.quote(w_['workspace_id'])}",
                       name, activate=not background)
    _locked(lambda d: d.__setitem__(name, {"wid": wid, "created": time.time(), "role": "session",
                                            "ws": w_["workspace_id"], "tid": p_["terminal_id"]}))
    time.sleep(0.8)
    if not _win_alive(wid):
        raise RuntimeError(f"the window for {name} closed right after opening (attach failed?)")
    tile(quiet=quiet)
    if background:
        raise_behind_manager(wid)                       # manager back on top of Terminal's stack (key)
        if before and frontmost_pid() != before:
            subprocess.run(["osascript", "-l", "JavaScript", "-e", JXA_REFRONT, before], capture_output=True)
    elif keep_manager_focus: refocus_manager()

def attach(name):
    """Runs inside the herd window. Not exec'd so cleanup runs on detach or on
    window close (SIGHUP/TERM), then retiles the remaining windows in the background."""
    import signal
    if re.fullmatch(r"w[0-9A-Za-z]+", name) and name in {w["workspace_id"] for w in workspaces()}:
        ws_id = name; p = next(x for x in panes() if x["workspace_id"] == ws_id)   # attach by workspace id
    else:
        w_, p = find(name); ws_id = w_["workspace_id"]
    child = subprocess.Popen(["herdr", "terminal", "attach", p["terminal_id"], "--takeover"])
    done = []
    def cleanup(*_):
        if done: return
        done.append(1)
        try: _locked(lambda d: [d.pop(k) for k in [k for k, r in d.items() if r.get("ws") == ws_id or k == name]])
        except Exception: pass
        subprocess.Popen(["nohup", os.path.abspath(sys.argv[0]), "tile"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    def on_sig(*_):
        cleanup(); 
        try: child.terminate()
        except Exception: pass
        os._exit(0)
    for sg in (signal.SIGHUP, signal.SIGTERM): signal.signal(sg, on_sig)
    signal.signal(signal.SIGINT, signal.SIG_IGN)  # Ctrl+C goes to the attached terminal, not us
    child.wait()
    cleanup()

def kill(name, quiet=False):
    w, _ = find(name)
    r = recorded(name)
    h("workspace", "close", w["workspace_id"])   # attach exits -> its own cleanup + retile
    if r:
        time.sleep(0.4); close_window(r["wid"])     # only that recorded herd window
        _locked(lambda d: d.pop(name, None)); tile(quiet=True)
    if not quiet: print(f"closed {name}")

def is_herd(label, recs):
    return label in recs or label.startswith("dev-") or label.startswith("test-")

def select_targets(labels, patterns=None):
    """Pure: which session names a killall would kill. No patterns -> all; else fnmatch any."""
    import fnmatch
    if not patterns: return list(labels)
    return [l for l in labels if any(fnmatch.fnmatchcase(l, p) for p in patterns)]

def killall(patterns=None, quiet=False):
    """Kill herdr workspaces: all of them (no patterns) or those matching any glob.
    Closes only their recorded herd windows (never the manager), then retiles once."""
    recs = _locked(lambda d: dict(d))
    ws = workspaces()
    targets = set(select_targets([w["label"] for w in ws], patterns))
    killed = []
    for w in ws:
        if w["label"] in targets:
            h("workspace", "close", w["workspace_id"]); killed.append(w["label"])
    if killed:
        time.sleep(0.4)
        for lab in killed:
            r = recs.get(lab)
            if r and lab != MGR and _win_alive(r["wid"]): close_window(r["wid"])
        _locked(lambda d: [d.pop(l, None) for l in killed if l != MGR])
        tile(quiet=True)
    if not quiet: print("killed: " + (", ".join(killed) if killed else "(none)"))
    return killed

def detach_client(terminal_id, timeout=3.0):
    """Stop only the `herdr terminal attach <id>` client(s); the session keeps running."""
    import signal
    # attach runs as `herdr terminal attach <id> --takeover`: match with or without trailing args
    r = subprocess.run(["pgrep", "-f", f"herdr terminal attach {terminal_id}( |$)"], capture_output=True, text=True)
    pids = [int(x) for x in r.stdout.split()]
    for pid in pids:
        try: os.kill(pid, signal.SIGTERM)
        except ProcessLookupError: pass
    end = time.time() + timeout
    while time.time() < end and any(_pid_alive(p) for p in pids): time.sleep(0.05)
    return pids

def _pid_alive(pid):
    try: os.kill(pid, 0); return True
    except OSError: return False

def detach(name):
    """X in the manager: close the session's herd window, keep the session. False if no window."""
    r = recorded(name)
    if not r: return False
    _, p = find(name)
    detach_client(p["terminal_id"])   # wrapper (exec'd, so the tab's only process) exits cleanly
    wid = int(r["wid"])
    for _ in range(60):               # wait until the tab runs nothing -> close without the prompt
        b = subprocess.run(["osascript", "-e", f'tell application "Terminal" to if exists window id {wid} then get busy of selected tab of window id {wid}'],
                           capture_output=True, text=True).stdout.strip()
        if b != "true": break
        time.sleep(0.05)
    else:
        _locked(lambda d: d.pop(name, None)); tile(quiet=True)
        raise RuntimeError(f"{name}: window still busy; not closing it (session kept)")
    if _win_alive(wid): close_window(wid)
    _locked(lambda d: d.pop(name, None))
    tile(quiet=True)
    return True

def attached_names():
    """Sessions with a live recorded herd window (manager excluded)."""
    recs = {n: r for n, r in _locked(lambda d: dict(d)).items() if n != MGR}
    if not recs: return []
    q = json.loads(_jxa(JXA_QUERY, [r["wid"] for r in recs.values()]))
    live = {w["label"] for w in workspaces()}
    return [n for n in sorted(recs, key=lambda n: recs[n]["created"]) if str(recs[n]["wid"]) in q["windows"] and n in live]

def broadcast(text, names=None):
    """Run `text` (+Enter) in every attached session. Returns the names it was sent to."""
    if not text.strip(): return []
    names = attached_names() if names is None else names
    for n in names:
        h("pane", "run", find(n)[1]["pane_id"], text)
    return names

def send_keys_all(key, names=None):
    """Send one key (herdr send-keys name, e.g. 'enter', 'ctrl+c') to every attached session."""
    names = attached_names() if names is None else names
    for n in names:
        h("pane", "send-keys", find(n)[1]["pane_id"], key)
    return names

def send_raw_all(data, names=None):
    """Live broadcast: forward exact terminal bytes (as text) to every attached session."""
    names = attached_names() if names is None else names
    for n in names:
        h("pane", "send-text", find(n)[1]["pane_id"], data)
    return names

KEYNAMES = {"\x1b[A": "<Up>", "\x1bOA": "<Up>", "\x1b[B": "<Down>", "\x1bOB": "<Down>",
            "\x1b[C": "<Right>", "\x1bOC": "<Right>", "\x1b[D": "<Left>", "\x1bOD": "<Left>",
            "\x1b[H": "<Home>", "\x1bOH": "<Home>", "\x1b[F": "<End>", "\x1bOF": "<End>",
            "\x1b[3~": "<Del>", "\x1b[5~": "<PgUp>", "\x1b[6~": "<PgDn>", "\x1bOP": "<F1>",
            "\x1bOQ": "<F2>", "\x1bOR": "<F3>", "\x1bOS": "<F4>"}

def split_keys(data):
    """Split raw input into tokens: escape sequences, single chars. Returns list of str."""
    out, i = [], 0
    while i < len(data):
        c = data[i]
        if c == "\x1b" and i + 1 < len(data) and data[i + 1] in "[O":
            j = i + 2
            if data[i + 1] == "[" and j < len(data) and data[j] == "M":   # X10 mouse: ESC [ M b x y
                out.append(data[i:j + 4]); i = j + 4; continue
            while j < len(data) and not ("\x40" <= data[j] <= "\x7e"): j += 1
            out.append(data[i:j + 1]); i = j + 1
        else: out.append(c); i += 1
    return out

def key_label(t):
    if t in KEYNAMES: return KEYNAMES[t]
    if t == "\x1b": return "<Esc>"
    if t in ("\r", "\n"): return "<Enter>"
    if t == "\t": return "<Tab>"
    if t == "\x7f": return "<BS>"
    if len(t) == 1 and ord(t) < 32: return "^" + chr(ord(t) + 64)
    if t.startswith("\x1b"): return "<" + t[1:].replace("\x1b", "") + ">"
    return t

def clean_clip():
    """Strip the trailing padding spaces herdr's attach renderer writes on every row
    (Terminal.app copies them, so lines come out full-width)."""
    t = subprocess.run(["pbpaste"], capture_output=True, text=True).stdout
    c = "\n".join(l.rstrip(" \t") for l in t.replace("\r\n", "\n").split("\n")).rstrip("\n")
    if t.endswith("\n"): c += "\n"
    subprocess.run(["pbcopy"], input=c, text=True, check=True)
    return len(t) - len(c)

def copy_session(name):
    """Copy the session's full retained output (herdr scrollback) to the macOS clipboard."""
    _, p = find(name)
    r = subprocess.run(["herdr", "pane", "read", p["pane_id"], "--source", "recent-unwrapped", "--lines", "1000000"],
                       capture_output=True, text=True)
    if r.returncode: raise RuntimeError(r.stderr.strip())
    try: text = json.loads(r.stdout)["result"]["read"]["text"]
    except Exception: text = r.stdout
    text = text.rstrip("\n") + "\n"
    subprocess.run(["pbcopy"], input=text, text=True, check=True)
    return text.count("\n")

def paste_session(name, text=None):
    """Type the clipboard into the session WITHOUT pressing Enter.
    Multi-line: at a shell prompt (bash/zsh/sh/fish) each newline is sent as Ctrl-V + newline
    (readline/zle quoted-insert), so the lines stay in ONE pending command line; macOS bash 3.2
    has no bracketed paste. For other foreground programs (agents, editors) the text is wrapped
    in bracketed-paste markers (ESC[200~ ... ESC[201~)."""
    _, p = find(name)
    if text is None: text = subprocess.run(["pbpaste"], capture_output=True, text=True).stdout
    if not text: return 0
    text = text.replace("\r\n", "\n").rstrip("\n") if "\n" in text else text
    payload = text
    if "\n" in text:
        try:
            fp = h("pane", "process-info", "--pane", p["pane_id"])["process_info"]["foreground_processes"]
            fg = (fp[0].get("name") or "").lstrip("-") if fp else ""
        except SystemExit: fg = ""
        payload = text.replace("\n", "\x16\n") if fg in ("bash", "zsh", "sh", "fish") else f"\x1b[200~{text}\x1b[201~"
    h("pane", "send-text", p["pane_id"], payload)
    return len(text)

def rename(old, new_):
    """Manual rename: the name sticks (auto naming skips it) until `herd rename --auto <name>`."""
    if not NAME_RE.match(new_): raise ValueError("bad name")
    if new_ in {w["label"] for w in workspaces()}: raise ValueError("name exists")
    w, _ = find(old)
    _relabel(w, new_)
    _meta(lambda d: d.__setitem__(w["workspace_id"], {"manual": True, "label": new_}))

def rename_auto(name):
    w, _ = find(name)
    _meta(lambda d: d.pop(w["workspace_id"], None))
    ch = auto_names()
    return dict(ch).get(w["label"], w["label"])

def app():
    if not recorded(MGR): manager_window(tile_after=False)
    r = subprocess.run([sys.argv[0], "new"], capture_output=True, text=True)
    if r.returncode: sys.exit(r.stderr)
    open_(r.stdout.split("\t")[0])

def sessions():
    """All herdr workspaces as rows for the manager."""
    ws = workspaces(); ps = panes()
    try:
        if auto_names(ws=ws, ps=ps): ws = workspaces()      # names follow cwd/branch changes
    except SystemExit: pass
    recs = _locked(lambda d: dict(d))
    rows = []
    for w in ws:
        p = next((x for x in ps if x["workspace_id"] == w["workspace_id"]), {})
        cmd = ""
        if p:
            cmd = prog_label(p)
            if p.get("agent") and p.get("agent_status"): cmd += f" ({p['agent_status']})"
        label = w["label"]
        rows.append({"name": label, "herd": True,
                     "window": label in recs, "cwd": detail_cwd(p.get("foreground_cwd") or p.get("cwd", "")),
                     "cmd": cmd, "agent": p.get("agent_status", "")})
    return rows

def start_dock():
    """Launch helper/herd-dock.swift (compiled on first use into ~/.cache/herd): dock outline overlay +
    drop detection. It exits when the returned pipe closes. None if disabled/unavailable."""
    if not config()["dock"]: return None
    src = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "helper", "herd-dock.swift")
    binp = os.path.expanduser("~/.cache/herd/herd-dock")
    try:
        if not os.path.exists(src): return None
        if not os.path.exists(binp) or os.path.getmtime(binp) < os.path.getmtime(src):
            os.makedirs(os.path.dirname(binp), exist_ok=True)
            if subprocess.run(["swiftc", "-O", "-o", binp, src], capture_output=True, timeout=180).returncode: return None
        return subprocess.Popen([binp], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError): return None

class Outline:
    """Green border around the selected session's herd window, drawn by a tiny Swift helper
    (helper/herd-outline.swift, compiled on first use into ~/.cache/herd). Click-through and
    non-activating; it exits when this pipe closes (manager quit/reload)."""
    def __init__(self):
        self.p = None; self.last = None; self.t = 0.0
        src = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "helper", "herd-outline.swift")
        binp = os.path.expanduser("~/.cache/herd/herd-outline")
        try:
            if not os.path.exists(src): return
            if not os.path.exists(binp) or os.path.getmtime(binp) < os.path.getmtime(src):
                os.makedirs(os.path.dirname(binp), exist_ok=True)
                if subprocess.run(["swiftc", "-O", "-o", binp, src], capture_output=True, timeout=180).returncode: return
            # 6px ring in the selection colour (SEL_RGB).
            rgb = os.environ.get("HERD_OUTLINE_RGB", SEL_RGB).split()
            radius = os.environ.get("HERD_OUTLINE_RADIUS", "16" if int(os.uname().release.split(".")[0]) >= 25 else "10")
            self.p = subprocess.Popen([binp, os.environ.get("HERD_OUTLINE_PX", "6"), radius, *rgb], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                      stderr=subprocess.DEVNULL, text=True)
        except (OSError, subprocess.SubprocessError): self.p = None
    def alive(self):
        """Restart the helper if it died (crash, killed)."""
        if self.p and self.p.poll() is not None:
            self.__init__()
        return bool(self.p)
    def _send(self, line):
        if not self.alive() or line == self.last: return
        try: self.p.stdin.write(line + "\n"); self.p.stdin.flush(); self.last = line
        except (OSError, ValueError): self.p = None
    def follow(self, name, force=False):
        """Point the border at session `name`'s window, at its LIVE frame (Terminal bounds, re-read ~1/s,
        so manual moves are followed), or hide if it has no window."""
        if not self.alive(): return
        if not force and time.time() - self.t < 1.0: return
        self.t = time.time()
        r = _locked(lambda d: d.get(name)) if name else None
        if not r: self._send("hide"); return
        if force: raise_behind_manager(r["wid"])
        q = subprocess.run(["osascript", "-e", f'tell application "Terminal" to if it is running then get bounds of window id {int(r["wid"])}'],
                           capture_output=True, text=True)
        b = [x.strip() for x in q.stdout.split(",")]
        self._send(" ".join(b) if q.returncode == 0 and len(b) == 4 else "hide")
    def stop(self):
        if self.p:
            try: self.p.stdin.close()
            except OSError: pass
            self.p = None

def zoom(name):
    """Toggle zoom on session `name`'s window (at most one zoomed). Returns 'on'/'off', or None if no window."""
    r = recorded(name)
    if not r: return None
    was = bool(r.get("zoom"))
    def f(d):
        for k, v in d.items():
            if k != MGR: v.pop("zoom", None)
        if not was and name in d: d[name]["zoom"] = True
    _locked(f); tile(quiet=True)
    return "off" if was else "on"

def mgr_zoom(cur, outline=None):
    """Manager Z key handler. Never changes the frontmost app."""
    with keep_front():
        z = zoom(cur)
        refocus_manager()
        if outline and z: outline.follow(cur, force=True)
    return f"{cur}: not attached" if z is None else f"zoom {z}: {cur}"

JXA_ACT_KEY = """ObjC.import('AppKit');
function run(argv){ var a = $.NSRunningApplication.runningApplicationWithProcessIdentifier(parseInt(argv[0]));
  if (a.isNil()) return 'gone'; a.activateWithOptions($.NSApplicationActivateIgnoringOtherApps); return 'ok'; }"""

def dock_raise():
    """Keep the docked window above the herd group. Only when Terminal is the active app (otherwise
    the docked app's window already sits above Terminal's): activate the docked app (its window comes
    up), then re-activate Terminal WITHOUT all-windows, so only the manager (key window) returns to
    the front and keeps keyboard focus. The dock doesn't overlap the manager column."""
    d = docked()
    if not d: return
    term = _terminal_pid()
    if not term or frontmost_pid() != term: return
    if subprocess.run(["kill", "-0", str(d["pid"])], capture_output=True).returncode: return
    subprocess.run(["osascript", "-l", "JavaScript", "-e", JXA_ACT_KEY, str(d["pid"])], capture_output=True)
    m = _locked(lambda x: x.get(MGR))
    if m: subprocess.run(["osascript", "-e", f'tell application "Terminal" to if it is running then set index of window id {int(m["wid"])} to 1'], capture_output=True)
    subprocess.run(["osascript", "-l", "JavaScript", "-e", JXA_ACT_KEY, term], capture_output=True)
    _herd_log(f"dock_raise pid={d['pid']}")

def raise_behind_manager(wid):
    """Bring a herd window to the top of Terminal's own window stack while the manager stays the
    front/key window: set index 1 on the target, then on the manager (they don't overlap when tiled).
    Doesn't activate Terminal, so windows of other apps that are in front stay in front."""
    m = _locked(lambda d: d.get(MGR))
    lines = [f"  set index of window id {int(wid)} to 1"]
    if m: lines.append(f"  set index of window id {int(m['wid'])} to 1")
    with keep_front():
        subprocess.run(["osascript", "-e", 'tell application "Terminal"\n  if it is running then\n' + "\n".join(lines) + "\n  end if\nend tell"],
                       capture_output=True)

JXA_APPS = """ObjC.import('AppKit'); JSON.stringify(ObjC.unwrap($.NSWorkspace.sharedWorkspace.runningApplications).map(function(a){
  return [ObjC.unwrap(a.localizedName) || '', a.processIdentifier, Number(a.activationPolicy), ObjC.unwrap(a.bundleIdentifier) || '']; }))"""

def apps_above_terminal():
    """Regular apps whose windows are in front of Terminal, front-to-back, as [(pid, bundle id)].
    Order from `lsappinfo visibleProcessList`; accessory/background apps (e.g. Wispr Flow) dropped."""
    out = subprocess.run(["lsappinfo", "visibleProcessList"], capture_output=True, text=True).stdout
    names = re.findall(r'ASN:0x[0-9a-f]+-0x[0-9a-f]+-"([^"]*)"', out)
    try: apps = json.loads(subprocess.run(["osascript", "-l", "JavaScript", "-e", JXA_APPS], capture_output=True, text=True).stdout or "[]")
    except ValueError: return []
    by_name = {}
    for n, pid, pol, bid in apps: by_name.setdefault(n.replace(" ", "_"), (str(pid), pol, bid))
    res = []; d = docked(); dpid = str(d["pid"]) if d else ""
    for n in names:
        pid, pol, bid = by_name.get(n, ("", -1, ""))
        if bid == "com.apple.Terminal": break
        if pid and int(pol) == 0 and pid != dpid: res.append((pid, bid))
    return res

def front_nonterm_pid():
    s = apps_above_terminal()
    return s[0][0] if s else ""

def _activate_pid(pid, bid=""):
    """Activate app `pid` with all its windows; verify it became frontmost, else retry via `open -b`."""
    subprocess.run(["osascript", "-l", "JavaScript", "-e", JXA_REFRONT_ALL, pid], capture_output=True, text=True)
    for _ in range(10):
        if frontmost_pid() == pid: return True
        time.sleep(0.05)
    if not bid:
        m = re.search(r'"CFBundleIdentifier"="([^"]+)"', subprocess.run(["lsappinfo", "info", "-only", "bundleid", pid], capture_output=True, text=True).stdout)
        bid = m.group(1) if m else ""
    if bid: subprocess.run(["open", "-b", bid], capture_output=True)
    for _ in range(10):
        if frontmost_pid() == pid: return True
        time.sleep(0.05)
    return False

def _herd_log(line):
    lp = os.path.expanduser("~/.cache/herd/focus.log")
    os.makedirs(os.path.dirname(lp), exist_ok=True)
    if os.path.exists(lp) and os.path.getsize(lp) > 200_000: os.replace(lp, lp + ".1")
    if True:
        with open(os.path.expanduser("~/.cache/herd/focus.log"), "a") as f: f.write(time.strftime("%H:%M:%S ") + line + "\n")

JXA_REFRONT_ALL = """ObjC.import('AppKit');
function run(argv){ var a = $.NSRunningApplication.runningApplicationWithProcessIdentifier(parseInt(argv[0]));
  if (a.isNil()) return 'gone'; a.activateWithOptions($.NSApplicationActivateAllWindows | $.NSApplicationActivateIgnoringOtherApps); return 'ok'; }"""

def _terminal_pid():
    r = subprocess.run(["pgrep", "-x", "Terminal"], capture_output=True, text=True)
    return r.stdout.split()[0] if r.stdout.split() else ""

def group_focus(state):
    """Manager F key. state = {"on": bool, "stack": [(pid, bundle)]} where stack (front-to-back) is
    kept fresh by the manager loop while a non-Terminal app is in front. Toggles the herd group
    (manager + every herd-tracked Terminal window from windows.json) between ON TOP of other apps and
    BEHIND them. Only herd-tracked windows are touched; nothing is minimized or hidden."""
    recs = _locked(lambda d: dict(d))
    mgr = recs.get(MGR)
    wids = [int(r["wid"]) for k, r in recs.items() if k != MGR and r.get("wid")]
    if not state.get("on"):
        front = frontmost_pid()
        if front and front != _terminal_pid():
            st = apps_above_terminal()
            if st: state["stack"] = st
        _herd_log(f"on: front={front!r} stack={state.get('stack')!r}")
        wids.sort(key=lambda w: any(r.get("zoom") and int(r.get("wid", 0)) == w for r in recs.values()))
        lines = [f"    try\n      set index of window id {w} to 1\n    end try" for w in wids]
        if mgr: lines.append(f"    try\n      set index of window id {int(mgr['wid'])} to 1\n    end try")
        lines.append("    activate")
        subprocess.run(["osascript", "-e", 'tell application "Terminal"\n  if it is running then\n' + "\n".join(lines) + "\n  end if\nend tell"],
                       capture_output=True)
        state["on"] = True
        dock_raise()                                              # docked app stays visible above the group
        return f"group on top ({len(wids)} windows + manager)"
    stack = [(p, b) for p, b in (state.get("stack") or []) if subprocess.run(["kill", "-0", p], capture_output=True).returncode == 0]
    if not stack:
        stack = apps_above_terminal()        # Terminal is front now, so this is usually empty
        if not stack:
            p = front_nonterm_pid_any()
            stack = [(p, "")] if p else []
    d = docked()
    if d: stack = [(p, b) for p, b in stack if p != str(d["pid"])]   # the docked app is not part of F
    for p, b in reversed(stack[1:]): _activate_pid(p, b)     # bottom-most first ...
    if d and stack and subprocess.run(["kill", "-0", str(d["pid"])], capture_output=True).returncode == 0:
        _activate_pid(str(d["pid"]), d.get("bundle", ""))    # docked app just under the top app
    ok = bool(stack) and _activate_pid(*stack[0])            # ... original top app last, verified
    fp = frontmost_pid()
    _herd_log(f"behind: stack={stack!r} ok={ok} front_after={fp!r}")
    state["on"] = False
    if not stack: return "! no other app to hand focus to"
    return f"group sent behind ({len(stack)} apps restored)" if ok else f"! could not activate {stack[0][1] or stack[0][0]} (front={fp})"

def front_nonterm_pid_any():
    """First regular non-Terminal app anywhere in the front-to-back order."""
    out = subprocess.run(["lsappinfo", "visibleProcessList"], capture_output=True, text=True).stdout
    names = re.findall(r'ASN:0x[0-9a-f]+-0x[0-9a-f]+-"([^"]*)"', out)
    try: apps = json.loads(subprocess.run(["osascript", "-l", "JavaScript", "-e", JXA_APPS], capture_output=True, text=True).stdout or "[]")
    except ValueError: return ""
    by = {n.replace(" ", "_"): (str(p), pol, b) for n, p, pol, b in apps}
    for n in names:
        p, pol, b = by.get(n, ("", -1, ""))
        if p and int(pol) == 0 and b != "com.apple.Terminal": return p
    return ""

def set_sessions_visible(visible):
    """H in the manager: hide/show every herd-tracked SESSION window (not the manager; never other
    windows) via Terminal's `visible` property. Sessions keep running and stay attached; nothing goes to
    the Dock. Showing retiles, which keeps the zoom state. Returns the number of windows changed."""
    recs = _locked(lambda d: dict(d))
    wids = [int(r["wid"]) for k, r in recs.items() if k != MGR and r.get("wid")]
    if not wids: return 0
    v = "true" if visible else "false"
    lines = [f"    try\n      set visible of window id {w} to {v}\n    end try" for w in wids]
    with keep_front():
        subprocess.run(["osascript", "-e", 'tell application "Terminal"\n  if it is running then\n' + "\n".join(lines) + "\n  end if\nend tell"],
                       capture_output=True)
        if visible:
            tile(quiet=True); refocus_manager()
    return len(wids)

def manager():
    import curses, signal
    if os.environ.get("HERD_TEST_SANDBOX"):   # headless tests: fake rows, every mutation only logged
        log = os.environ["HERD_TEST_SANDBOX"]
        n = int(os.environ.get("HERD_TEST_ROWS", "6"))
        g = globals(); sys.argv[0] = "/usr/bin/false"   # N's `herd new` subprocess can't run
        g["sessions"] = lambda: [{"name": f"fake-{i}", "herd": True, "window": i % 2 == 0, "cwd": "~", "cmd": "-bash", "agent": ""} for i in range(n)]
        g["attached_names"] = lambda: [f"fake-{i}" for i in range(n) if i % 2 == 0]
        for fn in ("auto_names", "send_raw_all", "send_keys_all", "broadcast", "refocus_manager", "open_", "kill", "killall", "rename", "new", "copy_session", "paste_session", "detach"):
            g[fn] = (lambda fn: lambda *a, **k: (open(log, "a").write(f"{fn} {a}\n"), a[1] if fn in ("broadcast", "send_keys_all", "send_raw_all") and len(a) > 1 else [])[1])(fn)
    def cleanup(*_):
        try: _locked(lambda d: d.pop(MGR, None))
        except Exception: pass
        subprocess.Popen(["nohup", os.path.abspath(sys.argv[0]), "tile"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    def on_sig(*_): cleanup(); os._exit(0)
    # Only drop the record if this process is the recorded manager window (headless runs don't touch it).
    in_window = os.environ.get("TERM_PROGRAM") == "Apple_Terminal"
    if in_window:
        for sg in (signal.SIGHUP, signal.SIGTERM): signal.signal(sg, on_sig)

    def ui(scr):
        curses.curs_set(0); scr.timeout(250); curses.use_default_colors(); curses.raw()
        # Mouse: ncurses enables xterm mode 1000 (X10 encoding), which Terminal.app sends with
        # TERM=xterm-256color. mouseinterval(0) = no click-resolution delay.
        # Wheel up = BUTTON4_PRESSED; on this
        # ncurses (6.0, ABI 5) wheel down arrives as REPORT_MOUSE_POSITION.
        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION); curses.mouseinterval(0)
        stub_open = os.environ.get("HERD_TEST_STUB_OPEN"); state_file = os.environ.get("HERD_TEST_STATE")
        try:
            curses.init_pair(1, curses.COLOR_CYAN, -1); curses.init_pair(2, curses.COLOR_GREEN, -1)
            curses.init_pair(3, curses.COLOR_YELLOW, -1); SEL_BG = SEL_256 if curses.COLORS >= 256 else curses.COLOR_BLUE
            curses.init_pair(4, curses.COLOR_WHITE, SEL_BG)                 # selected row: white on slate blue
            curses.init_pair(7, curses.COLOR_GREEN, SEL_BG)                 # its dot stays green
            curses.init_pair(5, curses.COLOR_RED, -1); curses.init_pair(6, curses.COLOR_WHITE, curses.COLOR_RED)
        except curses.error: pass
        C = lambda i: curses.color_pair(i)
        rows, sel, last, msg, top = [], 0, 0.0, "", 0
        show_help = [os.environ.get("HERD_MGR_HELP", "0") == "1"]; msg_seen = ["", 0.0]
        want_sel = [os.environ.get("HERD_MGR_SEL")]
        me = os.path.realpath(os.path.abspath(sys.argv[0])); mt0 = [os.path.getmtime(me)] if os.path.exists(me) else [0]
        def maybe_reload():
            """Auto-reload: if the herd script changed and still compiles, re-exec in place."""
            try: mt = os.path.getmtime(me)
            except OSError: return
            if mt == mt0[0]: return
            mt0[0] = mt
            if subprocess.run([sys.executable, "-m", "py_compile", me], capture_output=True).returncode: return
            os.environ["HERD_MGR_SEL"] = rows[sel]["name"] if rows else ""
            os.environ["HERD_MGR_HELP"] = "1" if show_help[0] else "0"
            curses.endwin()
            os.execv(sys.executable, [sys.executable, me] + sys.argv[1:])
        k_last = [None]; esc_until = [0.0]
        outline = Outline() if not os.environ.get("HERD_TEST_SANDBOX") and not os.environ.get("HERD_NO_OUTLINE") else None
        dock_helper = start_dock() if not os.environ.get("HERD_TEST_SANDBOX") else None   # noqa: F841 (pipe keeps it alive)
        sel_seen = [None]
        CTRL_SEND = {3: "ctrl+c", 4: "ctrl+d", 12: "ctrl+l", 21: "ctrl+u", 23: "ctrl+w", 26: "ctrl+z", 18: "ctrl+r"}
        CSI_MAP = {"A": curses.KEY_UP, "B": curses.KEY_DOWN, "C": curses.KEY_RIGHT, "D": curses.KEY_LEFT,
                   "H": curses.KEY_HOME, "F": curses.KEY_END, "1~": curses.KEY_HOME, "7~": curses.KEY_HOME,
                   "4~": curses.KEY_END, "8~": curses.KEY_END, "3~": curses.KEY_DC}
        def read_key():
            """getch + manual escape parsing. Returns a key code, 27 for a bare Esc, or None for
            any other escape sequence / Esc+char (ignored, never a command). Handles CSI (ESC [ ..)
            and SS3 (ESC O ..) arrows even when curses keypad doesn't decode them."""
            k = scr.getch()
            if k != 27: return k
            seq = []; scr.timeout(30)
            try:
                c = scr.getch()
                if c == -1: return 27                                   # bare Esc
                if c not in (ord("["), ord("O")):
                    return None                                          # Esc+char (Alt-x): ignore
                seq = [c]
                while len(seq) < 24:
                    c = scr.getch()
                    if c == -1: return None                              # truncated sequence: ignore
                    seq.append(c)
                    if seq[0] == ord("[") and len(seq) == 2 and c == ord("M"):
                        for _ in range(3): scr.getch()                   # raw X10 mouse: swallow
                        return None
                    if 0x40 <= c <= 0x7e: break                          # final byte
            finally: scr.timeout(250)
            body = "".join(chr(c) for c in seq[1:] if 0 <= c < 256)
            if body.endswith("~"): return CSI_MAP.get(body.split(";")[0])
            return CSI_MAP.get(body[-1:])                               # A/B/C/D/H/F (modifiers ignored)
        bc = {"focus": False, "echo": "", "n": 0}
        _herd_log(f"manager start pid={os.getpid()} version=0.5.8")
        hidden = [False]                                               # H: session windows hidden
        gf = {"on": False, "stack": [], "behind": False, "t": 0.0, "pt": 0.0}                                 # F: herd group focus state
        HELP = [["(N) new", "(O) open/detach", "(Z) toggle zoom"],
                ["(K) kill", "(A) killall", "(Q) quit", "(H) toggle hide", "(?) help", "(F) toggle focus"]]
        def wrap_items(items, width):
            """Greedy pack items (2-space separated) into lines <= width; never truncates."""
            lines, cur_ = [], ""
            for it in items:
                while len(it) > width:            # item wider than the window: hard-wrap it
                    if cur_: lines.append(cur_); cur_ = ""
                    lines.append(it[:width]); it = it[width:]
                cand = f"{cur_}  {it}" if cur_ else it
                if len(cand) <= width: cur_ = cand
                else: lines.append(cur_); cur_ = it
            if cur_: lines.append(cur_)
            return lines
        def put(y, x, t, a=0):
            H, W = scr.getmaxyx()
            if 0 <= y < H and x < W:
                try: scr.addnstr(y, x, t, max(0, W - x - 1), a)
                except curses.error: pass
        def prompt(q):
            H, W = scr.getmaxyx(); curses.echo(); curses.curs_set(1); scr.timeout(-1)
            put(H - 1, 0, " " * (W - 1)); put(H - 1, 0, q, C(3) | curses.A_BOLD)
            try: v = scr.getstr(H - 1, min(len(q), W - 2), 40).decode().strip()
            except Exception: v = ""
            curses.noecho(); curses.curs_set(0); scr.timeout(250); return v
        while True:
            if time.time() - last > 2:
                maybe_reload()
                try:
                    rows = sessions()
                    if want_sel[0]:
                        sel = next((i for i, r in enumerate(rows) if r["name"] == want_sel[0]), sel); want_sel[0] = None
                except SystemExit as e: msg = f"! {e}"
                except Exception as e: msg = f"! {e}"
                last = time.time()
            sel = max(0, min(sel, len(rows) - 1))
            if not gf["on"] and time.time() - gf["pt"] > 1.0:          # track last non-Terminal frontmost app
                gf["pt"] = time.time(); fp = frontmost_pid()
                if fp and fp != gf.setdefault("term", _terminal_pid()):
                    st = apps_above_terminal()
                    if st: gf["stack"] = st
            if gf["behind"] and time.time() - gf["t"] > 1.0:          # user clicked back into Terminal?
                gf["t"] = time.time()
                if frontmost_pid() == _terminal_pid(): gf["behind"] = False; sel_seen[0] = None
            if hidden[0] and time.time() - gf.get("ht", 0) > 1.0:      # stale hide flag: windows shown again?
                gf["ht"] = time.time()
                rs_ = [r_ for k_, r_ in _locked(lambda d: dict(d)).items() if k_ != MGR]
                if rs_ and subprocess.run(["osascript", "-e", f'tell application "Terminal" to get visible of window id {int(rs_[0]["wid"])}'],
                                          capture_output=True, text=True).stdout.strip() == "true":
                    hidden[0] = False; sel_seen[0] = None
            if outline and (gf["behind"] or hidden[0]): outline._send("hide")
            elif outline:
                cur_name = rows[sel]["name"] if rows else None
                outline.follow(cur_name, force=cur_name != sel_seen[0]); sel_seen[0] = cur_name
            scr.erase(); H, W = scr.getmaxyx()
            list_h = max(1, H - 2)                       # 1 row per session; divider + broadcast line at the bottom
            if sel < top: top = sel
            if sel >= top + list_h: top = sel - list_h + 1
            for i, r in enumerate(rows[top:top + list_h]):
                y = i; idx = top + i
                mark = "\u25cf" if r["window"] else "\u25cb"
                attr = C(4) | curses.A_BOLD if idx == sel else (C(2) if r["window"] else curses.A_NORMAL)
                line = f" {mark} {r['name']}"
                sub = f"  {r['cwd']}"
                sub = sub[:max(0, W - 1 - len(line))]
                if idx == sel:
                    put(y, 0, (line + sub).ljust(W - 1), attr)
                    put(y, 1, mark, C(7) | curses.A_BOLD)                # own pair: green dot on the selection bg
                else: put(y, 0, line, attr); put(y, len(line), sub, curses.A_DIM)
            py = H - 1                                   # the one bottom line
            pfx = " > "
            put(py - 1, 0, "\u2500" * (W - 1), curses.A_DIM)
            if msg != msg_seen[0]: msg_seen[:] = [msg, time.time()]
            if msg and time.time() - msg_seen[1] > 4: msg = ""          # transient status ~4s
            if bc["focus"]:
                cue = "(click list to end)"
                room = W - 1 - len(pfx) - (len(cue) + 1 if W - 1 - len(pfx) > len(cue) + 8 else 0)
                put(py, 0, pfx, curses.A_BOLD)
                if room < W - 1 - len(pfx): put(py, W - 1 - len(cue), cue, C(3))
            elif msg: put(py, 1, msg[:W - 2], C(5) if msg.startswith("!") else C(3))
            else: put(py, 0, pfx + "click for broadcast", curses.A_DIM)
            if show_help[0]:                             # hints overlay: centered box over the list
                hl = [l for items in HELP for l in wrap_items(items, max(1, W - 5))] + ["", "? / Esc: close"]
                bw = min(W - 1, max(len(l) for l in hl) + 4); bh = len(hl) + 2
                bx = max(0, (W - 1 - bw) // 2); by = max(0, (H - 2 - bh) // 2)
                put(by, bx, "\u250c" + "\u2500" * (bw - 2) + "\u2510", C(1))
                for i, l in enumerate(hl):
                    put(by + 1 + i, bx, "\u2502 " + l.ljust(bw - 4) + " \u2502", C(1) if l and not l.startswith("?") else curses.A_DIM)
                put(by + bh - 1, bx, "\u2514" + "\u2500" * (bw - 2) + "\u2518", C(1))
            if bc["focus"]:
                curses.curs_set(1)
                try: scr.move(py, len(pfx))
                except curses.error: pass
            else: curses.curs_set(0)
            scr.refresh()
            if state_file: open(state_file, "w").write(f"{sel} focus={bc['focus']} help={show_help[0]}")
            if os.environ.get("HERD_TEST_KEYLOG"): open(os.environ["HERD_TEST_KEYLOG"], "a").write(f"{k_last[0]}\n")
            if os.environ.get("HERD_TEST_DUMP"):
                dp = os.environ["HERD_TEST_DUMP"]
                open(dp + ".tmp", "w").write("\n".join(scr.instr(y, 0, W).decode(errors="replace").rstrip() for y in range(H)))
                os.replace(dp + ".tmp", dp)
            if bc["focus"]:
                # LIVE passthrough: read raw bytes from the tty (curses never sees them), keep mouse
                # events local, forward everything else unchanged as one batch.
                import select as _sel
                r_, _, _ = _sel.select([0], [], [], 0.25)
                if not r_: continue
                data = os.read(0, 4096)
                while _sel.select([0], [], [], 0.01)[0]:
                    more = os.read(0, 4096)
                    if not more: break
                    data += more
                fwd, exit_live = [], False
                for t in split_keys(data.decode("utf-8", errors="surrogateescape")):
                    if t.startswith("\x1b[M") and len(t) == 6:              # X10 mouse
                        b_, mx_, my_ = ord(t[3]) - 32, ord(t[4]) - 33, ord(t[5]) - 33
                        if b_ & 3 == 0 and not (b_ & 64) and my_ != py: exit_live = True
                        continue
                    if t.startswith("\x1b[<") and t[-1:] in "Mm":            # SGR mouse
                        try:
                            b_, mx_, my_ = (int(v) for v in t[3:-1].split(";")); my_ -= 1
                            if t[-1] == "M" and b_ & 3 == 0 and not (b_ & 64) and my_ != py: exit_live = True
                        except ValueError: pass
                        continue
                    fwd.append(t)
                if fwd:
                    payload = "".join(fwd)
                    try:
                        ns = send_raw_all(payload.encode("utf-8", errors="surrogateescape").decode("utf-8", errors="replace"), attached_names())
                        bc["n"] = len(ns)
                    except SystemExit as e: msg = f"! {e}"
                    except Exception as e: msg = f"! {e}"
                if exit_live:
                    bc["focus"] = False; esc_until[0] = time.time() + 0.3; msg = "live broadcast off"
                continue
            if time.time() - gf.get("dump", 0) > 2.0:                 # diagnostics for `cat ~/.cache/herd/manager-state.json`
                gf["dump"] = time.time()
                try:
                    json.dump({"t": time.strftime("%H:%M:%S"), "selected": rows[sel]["name"] if rows else None, "hidden": hidden[0],
                               "behind": gf["behind"], "focus_on": gf["on"], "outline_pid": outline.p.pid if outline and outline.p else None,
                               "outline_last": outline.last if outline else None}, open(os.path.expanduser("~/.cache/herd/manager-state.json"), "w"))
                except Exception: pass
            k = read_key()
            if k is None: continue
            if k != -1 and gf["behind"]:                               # a key reached the manager: Terminal is front
                gf["behind"] = False; sel_seen[0] = None
            if k != -1: k_last[0] = k
            if k == -1: continue
            if k == curses.KEY_RESIZE: continue
            do_open = False
            if k == curses.KEY_MOUSE:
                try: _, mx, my, _, bs = curses.getmouse()
                except curses.error: continue
                if bs & curses.BUTTON4_PRESSED: sel -= 1; continue
                if bs & (curses.REPORT_MOUSE_POSITION | getattr(curses, "BUTTON5_PRESSED", 0)): sel += 1; continue
                if bs & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED | curses.BUTTON1_DOUBLE_CLICKED):
                    if my == py:                             # click the > area: go LIVE
                        try: bc["n"] = len(attached_names())
                        except Exception: bc["n"] = 0
                        bc["focus"] = True; bc["echo"] = ""; msg = ""; continue
                    if my >= list_h: continue
                    idx = top + my
                    if idx >= len(rows): continue
                    sel = idx; continue                                # single click selects
                else: continue
            ch = chr(k) if 0 <= k < 256 else ""
            if ch and time.time() < esc_until[0] and ch.isalpha(): continue   # stray keys right after Esc
            cur = rows[sel]["name"] if rows else None
            try:
                if ch == "Q": return
                elif ch == "?": show_help[0] = not show_help[0]
                elif ch == "H":
                    hidden[0] = not hidden[0]
                    n_ = set_sessions_visible(not hidden[0]); sel_seen[0] = None; last = 0
                    msg = (f"hid {n_} windows (H shows them)" if hidden[0] else f"showing {n_} windows")
                elif k == 27 and show_help[0]: show_help[0] = False
                elif k in (curses.KEY_DOWN,) or ch == "j": sel += 1
                elif k in (curses.KEY_UP,) or ch == "k": sel -= 1
                elif ch == "O" and rows:                                   # Enter does nothing in list mode
                    if hidden[0]: hidden[0] = False; set_sessions_visible(True)   # unhide first
                    cur = rows[sel]["name"]
                    if rows[sel]["window"] and not stub_open:           # has a window: detach + close it
                        msg = f"detached {cur}" if detach(cur) else f"{cur}: not attached"; refocus_manager()
                    else:
                        if stub_open: open(stub_open, "a").write(cur + "\n")
                        else: open_(cur, quiet=True, background=True)
                        msg = f"opened {cur}"
                    sel_seen[0] = None; last = 0                       # outline follows right away
                elif ch == "A":
                    v = prompt(f"kill ALL {len(rows)} sessions? [y/N] ")
                    if v.lower() == "y":
                        ks = killall(None, quiet=True); refocus_manager(); msg = f"killed {len(ks)}: " + " ".join(ks); last = 0
                    else: msg = "kill all cancelled"
                elif ch == "K" and cur: kill(cur, quiet=True); refocus_manager(); msg = f"killed {cur}"; last = 0
                elif ch == "N":
                    if hidden[0]: hidden[0] = False; set_sessions_visible(True)   # unhide first
                    import contextlib, io
                    with contextlib.redirect_stdout(io.StringIO()): n = new()
                    if n: open_(n, quiet=True, background=True); msg = f"new {n}"; last = 0; sel_seen[0] = None
                elif ch == "F":
                    msg = group_focus(gf)
                    gf["behind"] = not gf["on"]; gf["t"] = time.time()
                    sel_seen[0] = None                                 # outline re-follows (or hides while behind)
                elif ch == "Z" and cur:
                    if hidden[0]: hidden[0] = False; set_sessions_visible(True)   # unhide first
                    msg = mgr_zoom(cur, outline); last = 0
            except SystemExit as e: msg = f"! {e}"
            except Exception as e: msg = f"! {e}"
    os.environ.setdefault("ESCDELAY", "25")
    # (the outline helper exits by itself when the manager's pipe closes)   # Esc leaves the broadcast prompt without a 1s lag
    try: curses.wrapper(ui)
    finally:
        if in_window: cleanup()

def main(a):
    if not a or a[0] in ("-h", "--help", "help"): print(__doc__); return
    c, rest = a[0], a[1:]
    if c == "new":
        name = d = None; args = list(rest)
        while args:
            a_ = args.pop(0)
            if a_ == "-C":
                if not args: sys.exit("herd new: -C needs a directory")
                d = args.pop(0)
            elif "/" in a_ or a_.startswith(("~", ".")) or os.path.isdir(a_): d = a_
            else: name = a_
        if d is not None:
            d = os.path.abspath(os.path.expanduser(d))
            if not os.path.isdir(d): sys.exit(f"herd new: no such directory: {d}")
        new(name, d)
    elif c == "ls": ls()
    elif c == "open" and rest: open_(rest[0])
    elif c == "kill" and rest: kill(rest[0])
    elif c == "killall": killall([x for x in rest if x != "--all"] or None)
    elif c == "copy" and rest: print(f"copied {copy_session(rest[0])} lines")
    elif c == "paste" and rest: print(f"pasted {paste_session(rest[0])} chars")
    elif c == "zoom" and rest: print({"on": "zoomed", "off": "unzoomed"}.get(zoom(rest[0]), "not attached"))
    elif c == "detach" and rest: print("detached" if detach(rest[0]) else "not attached")
    elif c == "cleanclip": print(f"cleanclip: removed {clean_clip()} padding chars")
    elif c == "broadcast" and rest:
        ns = broadcast(" ".join(rest)); print(f"sent to {len(ns)} sessions: " + ", ".join(ns))
    elif c == "tile": tile()
    elif c == "untile": print("untile: no-op placeholder")
    elif c == "attach" and rest: attach(rest[0])
    elif c == "_layout": [print(i, layout(*map(int, rest[:4]), i, manager=True)) for i in range(1, 7)] if "--manager" in rest else [print(i, grid(*map(int, rest[:4]), i)) for i in range(1, 10)]
    elif c == "manager": manager_window() if "--window" in rest else manager()
    elif c == "rename" and len(rest) == 2 and rest[0] == "--auto": print(rename_auto(rest[1]))
    elif c == "rename" and len(rest) == 2: rename(*rest)
    elif c == "names":   # one auto-naming pass (--dry-run to preview)
        for o, n in auto_names(apply="--dry-run" not in rest): print(f"{o}  ->  {n}")
    elif c == "id" and rest: print(find(rest[0])[1]["pane_id"])
    elif c == "app": app()  # used by Herd Terminal.app
    else: print(__doc__); sys.exit(2)
try:
    main(sys.argv[1:])
except (RuntimeError, subprocess.CalledProcessError) as e:
    msg_ = getattr(e, "stderr", None) or str(e)
    sys.exit(f"herd: {msg_.strip() if isinstance(msg_, str) else msg_}")
